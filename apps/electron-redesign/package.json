{
  "name": "@ank1015/llm-electron-redesign",
  "version": "0.1.0",
  "private": true,
  "description": "Redesigned full-stack Electron app (React renderer + Node backend) for the llm workspace",
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "pnpm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "eslint src tests electron.vite.config.ts",
    "clean": "node ../../scripts/remove-paths.mjs out dist release --tsbuildinfo"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react": "^1.1.6",
    "@monaco-editor/react": "^4.7.0",
    "hono": "^4.7.6",
    "monaco-editor": "^0.55.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.ank1015.llm.electron-redesign",
    "electronVersion": "39.8.7",
    "productName": "LLM Electron Redesign",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
